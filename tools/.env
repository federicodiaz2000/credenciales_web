# Configuración para tools/importar_credenciales.py
# URL base de la API (sin slash final)
API_BASE_URL=http://localhost:8081

# API key (debe coincidir con la configurada en el backend)
API_KEY=dev-secret-key

# Usuario y password para autenticarse (usuario debe existir en la B.D.)
USUARIO=admin
PASSWORD=admin

# Opciones de importación
OVERWRITE=false
WIPE=true
